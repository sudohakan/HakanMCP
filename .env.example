# =============================================================================
# HakanMCP — environment keys. Copy to .env and fill in only what you use.
# Every tool runs without these except where noted; a missing key disables just
# that one tool, not the server.
# =============================================================================

# GitHub API — for the git/GitHub tooling
GITHUB_TOKEN=

# GitBook API — for the `gitbook` tool
GITBOOK_TOKEN=

# Exa — for the `exaSearch` / `exaFindSimilar` / `exaGetContents` tools
EXA_API_KEY=

# Ollama (optional) — the `ollamaChat` tool resolves the host at runtime
# (OLLAMA_HOST, then localhost); set these only to override.
# OLLAMA_HOST=
# OLLAMA_CHAT_MODEL=

# Machine-specific paths (optional)
# Extra roots the http downloadFile tool may write under, separated by ':' (';' on Windows).
# Home and temp directories are always allowed.
# HAKANMCP_WRITE_ROOTS=/mnt/c/Users/<you>:/mnt/c/dev
# GitBook git sync: local mirror directory (default ~/gitbook-sync) and GitHub repo (owner/name).
# GITBOOK_SYNC_BASE=
# GITBOOK_SYNC_REPO=
# Catalog servers that run from a local checkout read their directory from these.
# INFOSET_MCP_DIR=
# GTASKS_MCP_DIR=
# teams tool: path to teams_browser.py (default ~/.claude/skills/teams-browser/scripts/teams_browser.py)
# TEAMS_BROWSER_CLI=
