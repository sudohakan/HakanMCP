# =============================================================================
# Hakan MCP — Environment Variables (Secrets & Overrides)
# Copy to .env and set values. Never commit .env to git.
# =============================================================================
# Config (config.yaml) → settings, URLs, intervals
# Secrets (this file) → API keys, tokens
# =============================================================================

# --- GitHub (required if config.github.enabled: true) ---
# https://github.com/settings/tokens — scopes: repo, public_repo
GITHUB_TOKEN=

# --- AI API Keys (optional; at least one recommended for chat/consciousness) ---
# Codex / OpenAI
CODEX_API_KEY=
# OPENAI_API_KEY=   # alternative to CODEX_API_KEY

# Claude / Anthropic
CLAUDE_CODE_API_KEY=
# ANTHROPIC_API_KEY=   # alternative to CLAUDE_CODE_API_KEY

# Gemini
GEMINI_API_KEY=

# --- Encrypted keys (if using config.aiProviders.*KeyEncrypted) ---
# AI_KEY_PASSWORD=

# --- AI Base URLs (override public API endpoints) ---
# CLAUDE_BASE_URL=https://api.anthropic.com/v1/messages
# CODEX_BASE_URL=https://api.openai.com/v1/chat/completions
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# --- Config overrides (optional; override config.yaml values) ---
# LOG_LEVEL=info
# HAKANMCP_LOG_LEVEL=info           # prefixed alternative to LOG_LEVEL
# CACHE_TTL=300
# HAKANMCP_CACHE_TTL=300            # prefixed alternative to CACHE_TTL
# GITBOOK_URL=https://your-gitbook-instance.gitbook.io/your-api
# MONITORING_PEER_INSTANCE=/peer    # Usually /peer in Docker
# SCHEDULER_ENABLED=true
# SELF_IMPROVEMENT_ENABLED=true
# AUTONOMY_ENABLED=true
# AUTONOMY_INTERVAL_SECONDS=600
# AUTONOMY_RUN_MAIN_GOAL=true
# AUTONOMY_RUN_SECOND_GOAL=true

# --- Paths (optional; defaults to project-relative locations) ---
# HAKANMCP_PROJECT_ROOT=            # Override detected project root
# FLOW_HISTORY_PATH=                # Flow execution history (default: logs/flows/history.jsonl)
# FLOW_CONNECTIONS_PATH=            # Flow connections file (default: logs/flows/connections.json)
# FLOW_VERSION_DIR=                 # Flow version storage directory
# KNOWLEDGE_GRAPH_DIR=              # Knowledge graph data directory (default: data/)

# --- Docker / development ---
# AUTO_RELOAD=true
# CHOKIDAR_USEPOLLING=true
