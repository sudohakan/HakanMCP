# =============================================================================
# HakanMCP — environment keys. Copy to .env and fill in only what you use.
# Every tool runs without these except where noted; a missing key disables just
# that one tool, not the server.
# =============================================================================

# GitHub API — for the git/GitHub tooling
GITHUB_TOKEN=

# GitBook API — for the `gitbook` tool
GITBOOK_TOKEN=

# Exa — for the `exaSearch` / `exaFindSimilar` / `exaGetContents` tools
EXA_API_KEY=

# Ollama (optional) — the `ollamaChat` tool resolves the host at runtime
# (OLLAMA_HOST, then localhost); set these only to override.
# OLLAMA_HOST=
# OLLAMA_CHAT_MODEL=
