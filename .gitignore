# ===========================
# HakanMCP .gitignore
# ===========================

# Dependencies
node_modules/

# Build output
dist/
docs/
dist-cjs/
build/
out/
*.tsbuildinfo

# Compiled JS in src (TypeScript project)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts

# Environment & Secrets
.env
.env.local
.env.*.local
*.key
*.pem

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test artifacts
coverage/
.nyc_output/
test-output/
test-reports/
test-warmup-output/
test-cooldown-output/
tests/logs/
tests/results/
*.lcov

# Runtime state (generated at runtime, not source)
.ai-provider-*.json
.ai-provider-*.jsonl
scheduler-state.json
hakanmcp.config.json
config.yaml
.mcp.json
init-output.log
mcp-server.log
swarm-debug.log

# Runtime data directories
.cache/
.swarm/
.hive-mind/
.hakanmcp/
/memory/
/coordination/
backups/
conversations/
tmp/

# Database files
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal

# HakanMCP generated binaries
hakanmcp
hakanmcp-mcp-wrapper
bin/hakanmcp-*
hive-mind-prompt-*.txt

# Python (if any scripts)
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
*.so
.Python

# SPARC/Roo (unused)
.roo/
.roomodes
.research/
.deno/
.turbo/
.agentic-flow/

# Planning docs (internal, not for GitHub)
.planning/

# Codex local config
.codex/

# Claude local settings
.claude/settings.local.json

# Misc
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
*.bak
output/
