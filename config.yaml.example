# ─── HakanMCP Configuration ───────────────────────────────────────
# Runtime config — overrides DEFAULT_CONFIG in src/config.ts
# Unknown keys are dropped on load, not rejected, so an old file still boots.

serverName: hakan-mcp
logLevel: info
cacheTtl: 300
retryCount: 3

# ─── GitHub ──────────────────────────────────────────────────────
# owner/repo are auto-detected from git remote origin.
# GITBOOK_TOKEN .env ile verilir
github:
  enabled: true
  branch: main
  private: true

# ─── Monitoring ───────────────────────────────────────────────────
monitoring:
  enabled: true
  checkInterval: 300000

# ─── Backup ──────────────────────────────────────────────────────
backup:
  enabled: true
  localPath: ./backups
  retentionHours: 48
  compressionEnabled: true
  includeNodeModules: false
  intervalHours: 1
